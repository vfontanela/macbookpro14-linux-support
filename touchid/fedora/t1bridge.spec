# Fedora port of packaging/arch/{t1bridge,t1bridge-dkms}.
# Rust binaries carry no separate debug info; skip the debuginfo split.
%global debug_package %{nil}

# Local mask of usbmuxd's rule (see %%triggerin). The first line marks a file
# generated by this package; a file without it belongs to the administrator.
%global usbmuxd_mask %{_sysconfdir}/udev/rules.d/39-usbmuxd.rules
%global mask_marker # t1bridge: generated from %{_udevrulesdir}/39-usbmuxd.rules without the Apple iBridge entries; local edits are overwritten
# Write the mask unless the existing file is the administrator's: it is ours
# when it carries the marker or (0.1.12-3 and older) equals the unmarked copy.
%global mask_usbmuxd \
src=%{_udevrulesdir}/39-usbmuxd.rules \
dst=%{usbmuxd_mask} \
if [ -f "$src" ]; then \
  mkdir -p %{_sysconfdir}/udev/rules.d \
  { echo '%{mask_marker}'; sed -e 's,|5ac/8600/\\*,,g' -e '\\,5ac/8600/,d' "$src"; } > "$dst.t1bridge-new" \
  if [ ! -e "$dst" ] || head -n1 "$dst" | grep -qF '# t1bridge: generated' || \\\
     tail -n +2 "$dst.t1bridge-new" | cmp -s - "$dst"; then \
    mv -f "$dst.t1bridge-new" "$dst" \
    udevadm control --reload >/dev/null 2>&1 || : \
  else \
    rm -f "$dst.t1bridge-new" \
    echo "t1bridge: $dst is a local administrator file; leaving it unchanged." >&2 \
    echo "t1bridge: remove 5ac/8600 from it, or usbmuxd returns the iBridge to USB configuration 1." >&2 \
  fi \
fi

Name:           t1bridge
Version:        0.1.12
Release:        4%{?dist}
Summary:        Apple T1 iBridge userspace services (Touch ID and Touch Bar)
License:        MIT
URL:            https://github.com/standardagents/t1bridge
Source0:        %{name}-%{version}.tar.gz

ExclusiveArch:  x86_64

BuildRequires:  cargo >= 1.88
BuildRequires:  rust >= 1.88
BuildRequires:  gcc
BuildRequires:  make
BuildRequires:  pkgconfig
BuildRequires:  libcurl-devel
BuildRequires:  libarchive-devel
BuildRequires:  openssl-devel
BuildRequires:  xz-devel
BuildRequires:  systemd-devel
BuildRequires:  systemd-rpm-macros
BuildRequires:  kernel-headers
BuildRequires:  selinux-policy-devel

Requires:       systemd >= 256
Requires:       iio-sensor-proxy
Requires:       %{name}-dkms = %{version}-%{release}
Requires:       %{name}-selinux = %{version}-%{release}
# Touch ID through fprintd needs the patched libfprint (driver "t1bridge").
Recommends:     libfprint >= 1.94.100
%{?systemd_requires}

%description
Linux services for the Apple T1 chip found in the 2016/2017 MacBook Pro with
Touch Bar: USB configuration selection, the private NCM link, xART
anti-replay storage, the Secure Enclave keybag relay, the Touch ID
authentication broker used by libfprint/fprintd, and the Touch Bar renderer.

%package dkms
Summary:        Kernel modules for the Apple T1 iBridge display, camera and private NCM link
License:        GPL-2.0-only AND GPL-2.0-or-later AND MIT
BuildArch:      noarch
Requires:       dkms
Requires:       kernel-devel
Requires:       dracut
# The legacy firmware-mode HID drivers drive the T1 in a configuration that
# has no Secure Enclave interface; they cannot coexist with T1Bridge.
Conflicts:      mbp-t1-touchbar-dkms

%description dkms
DKMS sources for t1_cfgsel (USB configuration selector), apple_t1_ncm
(private host<->T1 network), the T1 appletbdrm Touch Bar display driver and
a patched uvcvideo for the FaceTime camera.

%package selinux
Summary:        SELinux policy for T1Bridge services and fprintd
License:        MIT
BuildArch:      noarch
Requires:       selinux-policy-targeted
Requires(post): policycoreutils
Requires(postun): policycoreutils

%description selinux
Labels the T1Bridge service executables so systemd runs them as
unconfined_service_t, and allows the confined fprintd daemon to connect to
the root-only T1Bridge fingerprint socket in /run/t1bridge.

%prep
%autosetup -n %{name}-%{version}
sed -i 's/^PACKAGE_VERSION=.*/PACKAGE_VERSION="%{version}"/' kernel/dkms/dkms.conf
cp packaging/fedora/selinux/t1bridge.te packaging/fedora/selinux/t1bridge.fc .

%build
export CFLAGS="%{optflags}"
for spec in \
    "t1-touchbar-hw t1-touchbar-hw --features service" \
    "t1-touchbar t1-touchbar" \
    "t1-daemons t1-xart-storage" \
    "t1-daemons t1-ncm-ready" \
    "t1-daemons t1-keybag-relay --features keybag-relay-service" \
    "t1-daemons t1-touchid-auth --features auth-broker-service" \
    "t1-daemons t1-touchid" \
    "t1-daemons t1-legacy-recovery --features legacy-recovery" \
    "t1-import t1bridge"; do
  set -- $spec
  pkg=$1 bin=$2; shift 2
  cargo build --locked --release -p "$pkg" --bin "$bin" "$@"
done
make -f %{_datadir}/selinux/devel/Makefile t1bridge.pp

%install
lib=%{buildroot}%{_prefix}/lib/t1bridge
for b in t1-touchbar-hw t1-touchbar t1-xart-storage t1-ncm-ready \
         t1-keybag-relay t1-touchid-auth; do
  install -Dm755 target/release/$b $lib/$b
done
install -Dm750 target/release/t1-legacy-recovery $lib/t1-legacy-recovery
install -Dm755 target/release/t1-touchid %{buildroot}%{_bindir}/t1-touchid
install -Dm755 target/release/t1bridge %{buildroot}%{_bindir}/t1bridge

for u in t1-touchbar-hw.service t1-touchbar-hw.socket t1-xart-storage@.service \
         t1-ncm-ready@.service t1bridge-keybag.service t1-touchid-auth.service \
         t1-touchid-auth.socket t1bridge-fingerprint.socket t1bridge-import.service; do
  install -Dm644 systemd/$u %{buildroot}%{_unitdir}/$u
done
install -Dm644 systemd/user/t1-touchbar.service %{buildroot}%{_userunitdir}/t1-touchbar.service
install -Dm644 systemd/80-t1bridge.preset %{buildroot}%{_presetdir}/80-t1bridge.preset
install -Dm644 systemd/user/80-t1bridge.preset %{buildroot}%{_userpresetdir}/80-t1bridge.preset
install -Dm644 systemd/t1bridge.sysusers %{buildroot}%{_sysusersdir}/t1bridge.conf
install -Dm644 systemd/t1bridge.conf %{buildroot}%{_tmpfilesdir}/t1bridge.conf
install -Dm644 systemd/50-t1bridge-ncm.link %{buildroot}%{_prefix}/lib/systemd/network/50-t1bridge-ncm.link
install -Dm644 systemd/99-zz-t1bridge-touchbar.rules %{buildroot}%{_udevrulesdir}/99-zz-t1bridge-touchbar.rules
install -Dm644 systemd/90-t1bridge-xart.rules %{buildroot}%{_udevrulesdir}/90-t1bridge-xart.rules

# DKMS sources, same layout as the Arch package.
dkms=%{buildroot}%{_usrsrc}/%{name}-dkms-%{version}
install -d $dkms/kernel/{t1-cfgsel,appletbdrm-t1,apple-t1-ncm,uvcvideo-t1,dkms}
install -m644 kernel/t1-cfgsel/{Makefile,t1_cfgsel.c,t1_recovery_reset.h} $dkms/kernel/t1-cfgsel/
install -m644 kernel/appletbdrm-t1/{Makefile,appletbdrm.c,appletbdrm_resume.h,appletbdrm_protocol.h} $dkms/kernel/appletbdrm-t1/
install -m644 kernel/apple-t1-ncm/{Makefile,apple_t1_ncm.c} $dkms/kernel/apple-t1-ncm/
install -m644 kernel/uvcvideo-t1/{Makefile,uvc_*.c,uvc_*.h,uvcvideo.h} $dkms/kernel/uvcvideo-t1/
install -m644 kernel/dkms/Makefile $dkms/kernel/dkms/Makefile
install -m644 kernel/dkms/dkms.conf $dkms/dkms.conf
install -Dm644 packaging/arch/t1bridge-dkms/t1bridge.modules-load.conf %{buildroot}%{_modulesloaddir}/t1bridge.conf
install -Dm644 packaging/arch/t1bridge-dkms/t1bridge.modprobe.conf %{buildroot}%{_modprobedir}/t1bridge.conf
install -Dm644 packaging/fedora/90-t1bridge.dracut.conf %{buildroot}%{_prefix}/lib/dracut/dracut.conf.d/90-t1bridge.conf

install -Dm644 t1bridge.pp %{buildroot}%{_datadir}/selinux/packages/targeted/t1bridge.pp

%post
restorecon -R %{_prefix}/lib/t1bridge >/dev/null 2>&1 || :
%systemd_post t1-touchbar-hw.service t1-touchid-auth.socket t1bridge-fingerprint.socket
%systemd_user_post t1-touchbar.service
udevadm control --reload >/dev/null 2>&1 || :

# Fedora's usbmuxd rule forces every 05ac:8600 into USB configuration 1, which
# has no Secure Enclave interface and undoes t1_cfgsel. Mask that rule with a
# copy that leaves the iBridge alone; regenerated whenever usbmuxd changes.
# Not a %%ghost file: rpm would erase an administrator's own file on removal.
# Also run from %%posttrans: upgrading from 0.1.12-3, which listed it as
# %%ghost, erases the old copy after this package's trigger has run.
%triggerin -- usbmuxd
%{mask_usbmuxd}

%triggerpostun -- usbmuxd
if [ $2 -eq 0 ] && head -n1 %{usbmuxd_mask} 2>/dev/null | grep -qF '# t1bridge: generated'; then
  rm -f %{usbmuxd_mask}
fi

%posttrans
%{mask_usbmuxd}

%preun
%systemd_preun t1-touchbar-hw.service t1-touchid-auth.socket t1bridge-fingerprint.socket t1bridge-keybag.service t1-touchid-auth.service
%systemd_user_preun t1-touchbar.service

%postun
%systemd_postun t1-touchbar-hw.service
if [ $1 -eq 0 ] && head -n1 %{usbmuxd_mask} 2>/dev/null | grep -qF '# t1bridge: generated'; then
  rm -f %{usbmuxd_mask}
  udevadm control --reload >/dev/null 2>&1 || :
fi

%post dkms
dkms add -m %{name}-dkms -v %{version} -q --rpm_safe_upgrade || :

# After the whole transaction: an erased legacy driver (mbp-t1-touchbar-dkms)
# must not leave its modules-load.d entries in the regenerated initramfs, and
# an upgrade's old-package %%preun must not leave the modules removed.
# Failures are reported, not hidden: for the running kernel a missing module or
# an initramfs without t1_cfgsel means a dark Touch Bar and no Touch ID on the
# next boot, so the scriptlet fails visibly (rpm cannot roll back here).
%posttrans dkms
dkms add -m %{name}-dkms -v %{version} -q >/dev/null 2>&1 || :
running=$(uname -r)
failed=0
for k in /lib/modules/*/build; do
  [ -e "$k" ] || continue
  kv=$(basename "$(dirname "$k")")
  if ! dkms install -m %{name}-dkms -v %{version} -k "$kv" --force >/dev/null; then
    echo "t1bridge-dkms: ERROR: module build failed for kernel $kv (see: dkms status; /var/lib/dkms/%{name}-dkms/%{version}/build/make.log)" >&2
    failed=1; continue
  fi
  if ! dracut -f --kver "$kv"; then
    echo "t1bridge-dkms: ERROR: dracut failed for kernel $kv" >&2
    failed=1; continue
  fi
done
if [ ! -e /lib/modules/$running/build ]; then
  echo "t1bridge-dkms: ERROR: kernel-devel for the running kernel $running is not installed" >&2
  failed=1
elif ! lsinitrd --kver "$running" 2>/dev/null | grep -q 't1_cfgsel'; then
  echo "t1bridge-dkms: ERROR: t1_cfgsel is missing from the initramfs of $running" >&2
  failed=1
fi
[ $failed -eq 0 ] || { echo "t1bridge-dkms: Touch Bar/Touch ID will not work after reboot until this is fixed." >&2; exit 1; }

%preun dkms
dkms remove -m %{name}-dkms -v %{version} --all -q --rpm_safe_upgrade || :

%postun dkms
if [ $1 -eq 0 ]; then
  for k in /lib/modules/*/build; do
    dracut -f --kver "$(basename "$(dirname "$k")")" >/dev/null 2>&1 || :
  done
fi

%post selinux
semodule -n -r t1bridge_fprintd >/dev/null 2>&1 || :
semodule -n -i %{_datadir}/selinux/packages/targeted/t1bridge.pp || :
selinuxenabled && load_policy || :
restorecon -R %{_prefix}/lib/t1bridge >/dev/null 2>&1 || :

%postun selinux
if [ $1 -eq 0 ]; then
  semodule -n -r t1bridge >/dev/null 2>&1 || :
  selinuxenabled && load_policy || :
  restorecon -R %{_prefix}/lib/t1bridge >/dev/null 2>&1 || :
fi

%files
%license LICENSE THIRD_PARTY_NOTICES.md
%doc README.md docs/setup.md docs/touch-id.md docs/fedora.md
%{_bindir}/t1bridge
%{_bindir}/t1-touchid
%dir %{_prefix}/lib/t1bridge
%{_prefix}/lib/t1bridge/t1-touchbar-hw
%{_prefix}/lib/t1bridge/t1-touchbar
